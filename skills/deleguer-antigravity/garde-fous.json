{
  "toolPermission": "proceed-in-sandbox",
  "permissions": {
    "allow": [
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git blame)",
      "command(git grep)",
      "command(git ls-files)",
      "command(git rev-parse)",
      "command(Get-Date)"
    ],
    "deny": [
      "command(git push)",
      "command(regex:(?i).*\\bgit(\\.exe)?\\b.*\\bpush\\b.*)",
      "command(regex:(?i).*\\bgit(\\.exe)?[\"']?(\\s+(-[cC]\\s+(\"[^\"]*\"|'[^']*'|\\S+)|--(git-dir|work-tree|namespace|exec-path|config-env)(=\\S+|\\s+(\"[^\"]*\"|'[^']*'|\\S+))|-\\S+))*\\s+(add|am|apply|bisect|branch|checkout|checkout-index|cherry-pick|clean|clone|commit|commit-tree|config|credential|fetch|filter-branch|filter-repo|gc|init|lfs|maintenance|merge|mv|notes|pack-refs|prune|pull|read-tree|rebase|reflog|remote|repack|replace|reset|restore|revert|rm|sparse-checkout|stash|submodule|switch|symbolic-ref|tag|update-index|update-ref|worktree)\\b.*)",
      "command(gh)",
      "command(regex:(?i).*\\bgh(\\.exe)?\\s.*)",
      "command(regex:(?i).*(publish|deploy|upload).*)",
      "command(regex:(?i)(^|.*[^a-z0-9_-])(remove-item|rmdir|rd|rm|ri|del|erase|clear-content|clc|move-item|mv)(\\.exe)?([^a-z0-9_-].*|$))",
      "command(regex:(?i).*[.:]delete\\s*\\(.*)",
      "command(regex:(?i)(^|.*[^a-z0-9_-])(curl|wget|invoke-webrequest|iwr|invoke-restmethod|irm|ssh|scp|sftp|ftp|rsync|start-bitstransfer|bitsadmin|certutil)(\\.exe)?([^a-z0-9_-].*|$))",
      "command(regex:(?i).*(new-object\\s+(-typename\\s+)?(system\\.)?net\\.|\\[(system\\.)?net\\.|\\.(download|upload)(string|file|data)(async)?\\s*\\().*)",
      "command(regex:(?i)(^|.*[^a-z0-9_-])(invoke-expression|iex|invoke-command|icm)([^a-z0-9_-].*|$))",
      "command(regex:(?i).*\\b(powershell|pwsh)(\\.exe)?\\b.*\\s[-/](e|ec|en[a-z]*)\\s.*)",
      "command(regex:(?i)(^|.*[^a-z0-9_-])(start-process|saps|explorer|invoke-item|rundll32|mshta|wscript|cscript|reg|schtasks|sc|taskkill|stop-process|shutdown|restart-computer)(\\.exe)?([^a-z0-9_-].*|$))",
      "read_url(*)",
      "execute_url(*)",
      "download_url(*)",
      "mcp(*)"
    ]
  }
}
