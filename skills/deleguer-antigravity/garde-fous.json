{
  "toolPermission": "proceed-in-sandbox",
  "permissions": {
    "allow": [
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git blame)",
      "command(git grep)",
      "command(git ls-files)",
      "command(git rev-parse)",
      "command(Get-Date)",
      "command(gradlew)",
      "command(./gradlew)",
      "command(.\\gradlew)",
      "command(gradlew.bat)",
      "command(./gradlew.bat)",
      "command(.\\gradlew.bat)",
      "command(python -m unittest)",
      "command(python -m pytest)",
      "command(python -m py_compile)",
      "command(py -m unittest)",
      "command(py -m pytest)",
      "command(pytest)",
      "command(npm test)",
      "command(npm run build)",
      "command(npm run test)",
      "command(npm run lint)",
      "command(cargo build)",
      "command(cargo test)",
      "command(cargo check)",
      "command(dotnet build)",
      "command(dotnet test)"
    ],
    "deny": [
      "command(git push)",
      "command(regex:(?i).*\\bgit(\\.exe)?\\b.*\\bpush\\b.*)",
      "command(gh)",
      "command(regex:(?i).*\\bgh(\\.exe)?\\s.*)",
      "command(regex:(?i).*(publish|deploy|upload).*)",
      "command(git add)",
      "command(git commit)",
      "command(git remote)",
      "command(git config)",
      "command(git branch)",
      "command(git tag)",
      "command(git checkout)",
      "command(git switch)",
      "command(git restore)",
      "command(git reset)",
      "command(git clean)",
      "command(git rm)",
      "command(git stash)",
      "command(git merge)",
      "command(git rebase)",
      "command(git worktree)",
      "command(git fetch)",
      "command(git pull)",
      "command(rm)",
      "command(rmdir)",
      "command(rd)",
      "command(del)",
      "command(erase)",
      "command(ri)",
      "command(Remove-Item)",
      "command(regex:(?i)(^|.*[^a-z0-9_-])(remove-item|rmdir|rd|rm|ri|del|erase)(\\.exe)?([^a-z0-9_-].*|$))",
      "command(curl)",
      "command(wget)",
      "command(Invoke-WebRequest)",
      "command(Invoke-RestMethod)",
      "command(iwr)",
      "command(irm)",
      "command(ssh)",
      "command(scp)",
      "command(sftp)",
      "read_url(*)",
      "execute_url(*)",
      "mcp(*)"
    ]
  }
}
